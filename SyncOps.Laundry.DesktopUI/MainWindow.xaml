<Window x:Class="SyncOps.Laundry.DesktopUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SyncOps.Laundry.DesktopUI.ViewModels"
        xmlns:views="clr-namespace:SyncOps.Laundry.DesktopUI.Views.Pages"
        mc:Ignorable="d"
        Title="SyncOps Laundry &amp; Tailoring Suite — ERP &amp; POS" 
        Height="820" Width="1360"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgSubtleBrush}">

    <Window.Resources>
        <!-- DataTemplates para vincular automáticamente cada ViewModel con su View -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosRecepcionViewModel}">
            <views:PosRecepcionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TallerKanbanViewModel}">
            <views:TallerKanbanView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutoservicioViewModel}">
            <views:AutoservicioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventarioViewModel}">
            <views:InventarioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientesViewModel}">
            <views:ClientesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControlCajaViewModel}">
            <views:ControlCajaView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==============================================
             BARRA LATERAL DE NAVEGACIÓN (Sidebar Sapphire)
             ============================================== -->
        <Border Grid.Column="0" Background="{StaticResource BrandGradientBrush}">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO & TITULO DE MARCA -->
                <StackPanel Grid.Row="0" Margin="4,0,4,28">
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource BlueLightBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconWasher}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SyncOps" FontSize="18" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="LAUNDRY &amp; SUITE" FontSize="9.5" FontWeight="Bold" Foreground="#93C5FD"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Lavandería • Sastrería • Autoservicio" FontSize="11" Foreground="#BFDBFE" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- BOTONES DE NAVEGACIÓN DE MÓDULOS -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MÓDULOS PRINCIPALES" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" Margin="8,0,0,8"/>

                    <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Dashboard" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDashboard}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Panel &amp; Métricas"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="POS">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPos}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Punto de Venta / POS"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Kanban">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconKanban}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Tablero de Taller"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Autoservicio">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWasher}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Autoservicio &amp; Torres"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="ADMINISTRACIÓN &amp; CONTROL" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" Margin="8,20,0,8"/>

                    <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Inventario">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInventory}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Inventario Insumos"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Clientes">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClients}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Clientes &amp; Hoteles"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Caja">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCash}" Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0"/>
                            <TextBlock Text="Control de Caja"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- USUARIO Y VERSIÓN -->
                <Border Grid.Row="2" Background="#082A66" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{Binding UsuarioActual}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                        <TextBlock Text="Terminal Principal POS • v1.0.0" FontSize="10" Foreground="#93C5FD" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==============================================
             ÁREA PRINCIPAL DE CONTENIDO
             ============================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR (HEADER) -->
            <Border Grid.Row="0" Background="{StaticResource BgWhiteBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding PaginaActualTitulo}" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>

                    <!-- Estado de Caja & Conectividad -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{StaticResource StatusDoneBg}" BorderBrush="{StaticResource StatusDoneBorder}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusDoneDot}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EstadoCajaBadge}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource StatusDoneText}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BlueSubtleBrush}" BorderBrush="{StaticResource BlueBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BD Local / Cloud Sync" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BluePrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- HOSPEDAJE DINÁMICO DE LA VISTA SELECCIONADA -->
            <Border Grid.Row="1" Padding="24,20" Background="{StaticResource BgSubtleBrush}">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
