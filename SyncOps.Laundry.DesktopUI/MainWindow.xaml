<Window x:Class="SyncOps.Laundry.DesktopUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SyncOps.Laundry.DesktopUI.ViewModels"
        xmlns:views="clr-namespace:SyncOps.Laundry.DesktopUI.Views.Pages"
        mc:Ignorable="d"
        Title="SyncOps Laundry &amp; Tailoring Suite — ERP &amp; POS" 
        Height="840" Width="1380"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosRecepcionViewModel}">
            <views:PosRecepcionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TallerKanbanViewModel}">
            <views:TallerKanbanView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AutoservicioViewModel}">
            <views:AutoservicioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventarioViewModel}">
            <views:InventarioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientesViewModel}">
            <views:ClientesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControlCajaViewModel}">
            <views:ControlCajaView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==============================================
             BARRA LATERAL (SIDEBAR BLANCO MODERNO SYNCOPS)
             ============================================== -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BRAND HEADER -->
                <Grid Grid.Row="0" Margin="4,0,4,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon Container Soft Sapphire -->
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BlueSubtleBrush}" BorderBrush="{StaticResource BlueBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconWasher}" Fill="{StaticResource BlueVibrantBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sync" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BlueDeepBrush}"/>
                                <TextBlock Text="Ops" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource BlueVibrantBrush}"/>
                            </StackPanel>
                            <TextBlock Text="LAUNDRY &amp; SUITE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- NAVEGACIÓN -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="MÓDULOS PRINCIPALES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="8,4,0,8"/>

                        <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Dashboard" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Panel &amp; Métricas"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="POS">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPos}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Punto de Venta / POS"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Kanban">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconKanban}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Tablero de Taller"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Autoservicio">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWasher}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Autoservicio &amp; Torres"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="ADMINISTRACIÓN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="8,20,0,8"/>

                        <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Inventario">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInventory}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Inventario Insumos"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Clientes">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClients}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Clientes &amp; Hoteles"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" Command="{Binding NavegarCommand}" CommandParameter="Caja">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCash}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Control de Caja"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- FOOTER DE USUARIO -->
                <Border Grid.Row="2" Background="{StaticResource BgHoverBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Avatar circle -->
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="{StaticResource BlueVibrantBrush}" Margin="0,0,8,0">
                            <TextBlock Text="LB" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UsuarioActual}" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Administrador • POS 01" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==============================================
             ÁREA PRINCIPAL DE CONTENIDO
             ============================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR BLANCA ELEGANTE -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding PaginaActualTitulo}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>

                    <!-- Badges de Estado -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Caja Status -->
                        <Border Background="{StaticResource StatusDoneBg}" BorderBrush="{StaticResource StatusDoneBorder}" BorderThickness="1" CornerRadius="20" Padding="10,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource StatusDoneDot}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EstadoCajaBadge}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource StatusDoneText}"/>
                            </StackPanel>
                        </Border>

                        <!-- Cloud / DB Status -->
                        <Border Background="{StaticResource BlueSubtleBrush}" BorderBrush="{StaticResource BlueBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource BlueVibrantBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="BD Local SQLite (WAL Mode)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BluePrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENEDOR DE PÁGINA ACTIVA -->
            <Border Grid.Row="1" Padding="28,24" Background="{StaticResource BgBaseBrush}">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
