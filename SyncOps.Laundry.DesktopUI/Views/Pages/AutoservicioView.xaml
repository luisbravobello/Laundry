<UserControl x:Class="SyncOps.Laundry.DesktopUI.Views.Pages.AutoservicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ==============================================
             COLUMNA IZQUIERDA: MONITOREO DE MÁQUINAS EN VIVO
             ============================================== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <!-- Encabezado -->
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Monitoreo de Autoservicio &amp; Máquinas" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBlock Text="Control de torres con monedas y lavadoras/secadoras industriales de gran volumen" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource OutlineButton}" Command="{Binding CargarMaquinasCommand}" Content="⟳ Actualizar Estado" Padding="12,6"/>
                </Grid>

                <!-- SECCIÓN 1: TORRES COMBO CON MONEDAS (Estilo EE. UU. / Speed Queen) -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWasher}" Fill="{StaticResource BlueVibrantBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Torres Combo Lavadora / Secadora (Operadas por Monedas)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BlueDeepBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="Capacidad: 30 Lbs / Fichas SyncOps" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TorresMonedas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="230" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <!-- Código e Indicador de Estado -->
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="{Binding CodigoIdentificador}" FontWeight="ExtraBold" FontSize="15" Foreground="{StaticResource BluePrimaryBrush}" FontFamily="{StaticResource MonoFont}"/>
                                                <Border HorizontalAlignment="Right" CornerRadius="6" Padding="6,2" Background="{StaticResource StatusDoneBg}">
                                                    <TextBlock Text="{Binding Estado}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource StatusDoneText}"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding NombreDescriptivo}" FontSize="11" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <!-- Recaudación Cajetín Monedas -->
                                            <Border Background="{StaticResource BlueSubtleBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                                <Grid>
                                                    <TextBlock Text="Cajetín Monedas:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock HorizontalAlignment="Right" Text="{Binding RecaudacionCajetinActual, StringFormat='RD${0:N0}'}" FontWeight="Bold" Foreground="{StaticResource BlueDeepBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                                </Grid>
                                            </Border>

                                            <!-- Botones Iniciar Ciclo / Vaciar Cajetín -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Iniciar Ciclo" Command="{Binding DataContext.IniciarCicloCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4,6" FontSize="11"/>
                                                <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="Vaciar $" Command="{Binding DataContext.VaciarCajetinMonedasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4,6" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- SECCIÓN 2: MÁQUINAS INDUSTRIALES DE GRAN VOLUMEN (Hoteles / Carga Pesada) -->
                <Border Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconWasher}" Fill="#4338CA" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Lavadoras y Secadoras Industriales de Gran Volumen (75-80 Lbs)" FontSize="14" FontWeight="Bold" Foreground="#312E81" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="Para Hoteles, Edredones y Mantelería" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding MaquinasIndustriales}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="260" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="{Binding CodigoIdentificador}" FontWeight="ExtraBold" FontSize="15" Foreground="#312E81" FontFamily="{StaticResource MonoFont}"/>
                                                <Border HorizontalAlignment="Right" CornerRadius="6" Padding="6,2" Background="{StaticResource StatusDoneBg}">
                                                    <TextBlock Text="{Binding Estado}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource StatusDoneText}"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding NombreDescriptivo}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding CapacidadLibras, StringFormat='Capacidad: {0} Lbs / Duración: {1} min'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                                            <Button Style="{StaticResource SuccessButton}" Content="Iniciar Ciclo Industrial ➔" Command="{Binding DataContext.IniciarCicloCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,7" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==============================================
             COLUMNA DERECHA: DISPENSADOR / VENTA DE FICHAS
             ============================================== -->
        <Border Grid.Column="2" Style="{StaticResource ModernCard}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Venta de Fichas / Monedas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                    <Path HorizontalAlignment="Right" Data="{StaticResource IconCoin}" Fill="{StaticResource BlueVibrantBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Grid>

                <TextBlock Text="Emisión rápida de fichas de autoservicio para clientes de las torres de lavado." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                <!-- Cantidad de Fichas -->
                <TextBlock Text="Cantidad de Monedas/Fichas:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding FichasAVender, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

                <!-- Precio Unitario -->
                <TextBlock Text="Precio por Ficha (RD$):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding PrecioPorFicha, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,12"/>

                <!-- Nombre Cliente Opcional -->
                <TextBlock Text="Cliente (Opcional):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding ClienteFichasNombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <!-- TOTAL A COBRAR -->
                <Border Background="{StaticResource BlueSubtleBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="TOTAL COBRO:" FontWeight="ExtraBold" Foreground="{StaticResource BlueDeepBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" Text="{Binding TotalVentaFichasCalculado, StringFormat='RD${0:N2}'}" FontWeight="ExtraBold" Foreground="{StaticResource BlueDeepBrush}" FontFamily="{StaticResource MonoFont}" FontSize="18"/>
                    </Grid>
                </Border>

                <!-- BOTÓN VENDER FICHAS -->
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding VenderFichasCommand}" Height="42" FontSize="13">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="VENDER FICHAS &amp; REGISTRAR" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding MensajeEstado}" Foreground="{StaticResource BluePrimaryBrush}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
