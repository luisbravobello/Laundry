<UserControl x:Class="SyncOps.Laundry.DesktopUI.Views.Pages.ControlCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: MOVIMIENTOS DEL TURNO ACTUAL -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Movimientos y Cobros del Turno" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBlock Text="{Binding TurnoActual.CajeroUsuario, StringFormat='Cajero: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource OutlineButton}" Command="{Binding CargarCajaCommand}" Content="⟳ Actualizar" Padding="10,5"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding MovimientosTurno}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}" RowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat='{}{0:hh:mm tt}'}" Width="85"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTransaccion}" Width="120"/>
                        <DataGridTextColumn Header="Concepto / Detalle" Binding="{Binding Concepto}" Width="*"/>
                        <DataGridTextColumn Header="Método Pago" Binding="{Binding MetodoPago}" Width="110"/>
                        <DataGridTextColumn Header="Monto (RD$)" Binding="{Binding Monto, StringFormat='RD${0:N2}'}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- COLUMNA DERECHA: RESUMEN DE INGRESOS & ARQUEO / CIERRE DE CAJA -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- RESUMEN DE INGRESOS -->
                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Resumen de Ingresos del Turno" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BluePrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Fondo Inicial:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding TurnoActual.FondoInicialEfectivo, StringFormat='RD${0:N2}'}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Efectivo en Caja:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding TurnoActual.TotalEfectivoCalculado, StringFormat='RD${0:N2}'}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Monedas / Fichas Autoservicio:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding TurnoActual.TotalMonedasFichasCalculado, StringFormat='RD${0:N2}'}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Tarjetas (POS):" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding TurnoActual.TotalTarjetaCalculado, StringFormat='RD${0:N2}'}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Transferencias:" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock HorizontalAlignment="Right" Text="{Binding TurnoActual.TotalTransferenciaCalculado, StringFormat='RD${0:N2}'}" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                        </Grid>

                        <Border Background="{StaticResource BlueSubtleBrush}" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <TextBlock Text="TOTAL INGRESOS:" FontWeight="ExtraBold" Foreground="{StaticResource BlueDeepBrush}" FontSize="13"/>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding TurnoActual.TotalIngresosDia, StringFormat='RD${0:N2}'}" FontWeight="ExtraBold" Foreground="{StaticResource BlueDeepBrush}" FontFamily="{StaticResource MonoFont}" FontSize="16"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- FORMULARIO DE ARQUEO Y CIERRE -->
                <Border Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock Text="Arqueo y Cierre de Turno" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BlueDeepBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Efectivo Físico Contado (RD$):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EfectivoDeclarado, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,10"/>

                        <TextBlock Text="Monedas Físicas Contadas (RD$):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding MonedasDeclarado, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,10"/>

                        <TextBlock Text="Observaciones de Cierre:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding ObservacionesCierre, UpdateSourceTrigger=PropertyChanged}" Height="50" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CerrarCajaCommand}" Content="CERRAR TURNO &amp; ARQUEO" Height="40" Background="#DC2626"/>
                        <TextBlock Text="{Binding MensajeEstado}" Foreground="{StaticResource BluePrimaryBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
