<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================
         PALETA SYNCOPS MODERNA (Light Mode / High Contrast)
         ======================================================== -->
    <!-- Azules Corporativos -->
    <Color x:Key="BlueDeepColor">#0F3A8A</Color>
    <Color x:Key="BluePrimaryColor">#1E40AF</Color>
    <Color x:Key="BlueVibrantColor">#2563EB</Color>
    <Color x:Key="BlueLightColor">#3B82F6</Color>
    <Color x:Key="BlueSubtleColor">#EFF6FF</Color>
    <Color x:Key="BlueBorderColor">#DBEAFE</Color>

    <SolidColorBrush x:Key="BlueDeepBrush" Color="{StaticResource BlueDeepColor}"/>
    <SolidColorBrush x:Key="BluePrimaryBrush" Color="{StaticResource BluePrimaryColor}"/>
    <SolidColorBrush x:Key="BlueVibrantBrush" Color="{StaticResource BlueVibrantColor}"/>
    <SolidColorBrush x:Key="BlueLightBrush" Color="{StaticResource BlueLightColor}"/>
    <SolidColorBrush x:Key="BlueSubtleBrush" Color="{StaticResource BlueSubtleColor}"/>
    <SolidColorBrush x:Key="BlueBorderBrush" Color="{StaticResource BlueBorderColor}"/>

    <!-- Índigo / Violeta Moderno -->
    <SolidColorBrush x:Key="IndigoPrimaryBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="IndigoSubtleBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="IndigoBorderBrush" Color="#C7D2FE"/>

    <!-- Fondos y Superficies -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BgWhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSubtleBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1"/>

    <!-- Textos de Alta Legibilidad -->
    <SolidColorBrush x:Key="TextMainBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextBodyBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#94A3B8"/>

    <!-- ========================================================
         ESTADOS SEMÁNTICOS (WCAG 2.1 AA)
         ======================================================== -->
    <!-- 1. Por Hacer / Recibido -->
    <SolidColorBrush x:Key="StatusTodoBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="StatusTodoText" Color="#1E293B"/>
    <SolidColorBrush x:Key="StatusTodoBorder" Color="#94A3B8"/>
    <SolidColorBrush x:Key="StatusTodoDot" Color="#64748B"/>

    <!-- 2. En Progreso / Taller -->
    <SolidColorBrush x:Key="StatusProgressBg" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="StatusProgressText" Color="#312E81"/>
    <SolidColorBrush x:Key="StatusProgressBorder" Color="#818CF8"/>
    <SolidColorBrush x:Key="StatusProgressDot" Color="#4F46E5"/>

    <!-- 3. En Revisión / Planchado -->
    <SolidColorBrush x:Key="StatusReviewBg" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="StatusReviewText" Color="#78350F"/>
    <SolidColorBrush x:Key="StatusReviewBorder" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusReviewDot" Color="#D97706"/>

    <!-- 4. Completado / Listo para Entrega -->
    <SolidColorBrush x:Key="StatusDoneBg" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="StatusDoneText" Color="#064E3B"/>
    <SolidColorBrush x:Key="StatusDoneBorder" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusDoneDot" Color="#059669"/>

    <!-- 5. Peligro / Alerta -->
    <SolidColorBrush x:Key="StatusDangerBg" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="StatusDangerText" Color="#991B1B"/>
    <SolidColorBrush x:Key="StatusDangerBorder" Color="#F87171"/>
    <SolidColorBrush x:Key="StatusDangerDot" Color="#DC2626"/>

    <!-- Gradientes Vibrantes -->
    <LinearGradientBrush x:Key="VibrantGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0.0"/>
        <GradientStop Color="#1D4ED8" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
